        "CostCenter": "1000",
        "Workload": "CoreInfra",
        "Owner": "cloudops@contoso.com",
        "Application": "TestWorkload"
      },
      "metadata": {
        "description": "Governance tags"
      }
    }
  },
  "variables": {
    "subnetRef": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'contoso-con-cc-core-vnet', 'snet-core')]"
