        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'contoso-con-cc-dc01-nic')]"
            }
          ]
        }
      },
      "dependsOn": [
