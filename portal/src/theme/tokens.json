{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "tactical-ui",
    "version": "2.0.0",
    "lastUpdated": "2026-10-21",
    "description": "Tactical HUD React telemetry and Editorial Swiss Grid design system"
  },
  "color": {
    "dark": {
      "bgCanvas": "#06252D",
      "bgSurface": "#12323E",
      "bgElevated": "#16404C",
      "bgHover": "#1C4E5C",
      "bgGlass": "rgba(6, 37, 45, 0.88)",
      "textPrimary": "#F5F5F5",
      "textSecondary": "#9BA5B1",
      "textMuted": "#7E8C93",
      "accentPrimary": "#48A9A6",
      "accentHover": "#5CC2BF",
      "accentEmerald": "#64BA6D",
      "accentHud": "#249D79",
      "accentCyan": "#00E5FF",
      "accentAmber": "#E69A38",
      "accentRose": "#FF5252",
      "borderHairline": "rgba(39, 74, 86, 0.85)",
      "borderStrong": "rgba(155, 165, 177, 0.28)",
      "borderAccent": "rgba(72, 169, 166, 0.45)"
    },
    "light": {
      "bgCanvas": "#FAFAFC",
      "bgSurface": "#FFFFFF",
      "bgElevated": "#F0F4F6",
      "bgHover": "#E4ECF0",
      "bgGlass": "rgba(250, 250, 252, 0.88)",
      "textPrimary": "#06252D",
      "textSecondary": "#3D5A64",
      "textMuted": "#68828C",
      "accentPrimary": "#217B79",
      "accentHover": "#185C5B",
      "accentEmerald": "#2E8537",
      "accentHud": "#1E7D61",
      "accentCyan": "#007A99",
      "accentAmber": "#B87018",
      "accentRose": "#C23838",
      "borderHairline": "rgba(6, 37, 45, 0.12)",
      "borderStrong": "rgba(6, 37, 45, 0.25)",
      "borderAccent": "rgba(33, 123, 121, 0.35)"
    }
  },
  "typography": {
    "fontDisplay": "'Spectral', Georgia, 'Times New Roman', serif",
    "fontSans": "'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontMono": "'IBM Plex Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
  },
  "layout": {
    "containerMax": "1360px",
    "radiusSm": "2px",
    "radiusMd": "4px",
    "radiusPill": "9999px",
    "easeSnappy": "160ms cubic-bezier(0.16, 1, 0.3, 1)"
  }
}